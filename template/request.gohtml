{{define "request"}}
<div class="row">
	<div class="col-12 mb-3">
		<div class="card shadow-sm border-0">
			<div class="card-header bg-info text-white d-flex align-items-center">
				<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="mr-2" viewBox="0 0 16 16">
					<path d="M14 1a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1h12zM2 0a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2H2z"/>
					<path d="M5.854 4.146a.5.5 0 1 0-.708.708L7.293 7H3.5a.5.5 0 0 0 0 1h3.793l-2.147 2.146a.5.5 0 0 0 .708.708l3-3a.5.5 0 0 0 0-.708l-3-3z"/>
				</svg>
				<strong>HTTP Request</strong>
			</div>
			<div class="card-body p-0">
				<pre class="request-pre mb-0">{{- . -}}</pre>
			</div>
		</div>
	</div>
</div>
{{end}}
