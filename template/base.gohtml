<!DOCTYPE HTML>
<html class="vh-100">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<link rel="stylesheet" href="/static/css/bootstrap.min.css">
		<link rel="stylesheet" href="/static/css/whoami.css">
		<link rel="icon" type="img/png" href="/static/images/favicon.png">
		<title>{{.Title}}</title>
	</head>
	<body class="vh-100 bg-light">
		<section class="d-flex flex-column vh-100">
			<nav class="navbar navbar-dark bg-dark shadow-sm">
				<a class="navbar-brand font-weight-bold" href="/">
					<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="d-inline-block align-top mr-1" viewBox="0 0 16 16">
						<path d="M11 6a3 3 0 1 1-6 0 3 3 0 0 1 6 0z"/>
						<path fill-rule="evenodd" d="M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8zm8-7a7 7 0 0 0-5.468 11.37C3.242 11.226 4.805 10 8 10s4.757 1.225 5.468 2.37A7 7 0 0 0 8 1z"/>
					</svg>
					WhoAmI
				</a>
				<div class="navbar-nav ml-auto flex-row flex-wrap">
					<div class="nav-dropdown">
						<a class="nav-link px-2" href="#">System Info</a>
						<div class="nav-dropdown-menu">
							<a class="nav-dropdown-item" href="/">Host &amp; Network</a>
							<a class="nav-dropdown-item" href="/env">Environment</a>
							<a class="nav-dropdown-item" href="/k8s">K8s Metadata</a>
							<a class="nav-dropdown-item" href="/resources">Resource Limits</a>
							<a class="nav-dropdown-item" href="/volumes">Volumes</a>
							<a class="nav-dropdown-item" href="/osinfo">OS &amp; Runtime</a>
							<a class="nav-dropdown-item" href="/dns">DNS Config</a>
						</div>
					</div>
					<div class="nav-dropdown">
						<a class="nav-link px-2" href="#">HTTP Tools</a>
						<div class="nav-dropdown-menu">
							<a class="nav-dropdown-item" href="/headers">Echo Headers</a>
							<a class="nav-dropdown-item" href="/status">Status Code</a>
							<a class="nav-dropdown-item" href="/delay">Response Delay</a>
							<a class="nav-dropdown-item" href="/counter">Request Counter</a>
						</div>
					</div>
					<div class="nav-dropdown">
						<a class="nav-link px-2" href="#">Resilience</a>
						<div class="nav-dropdown-menu">
							<a class="nav-dropdown-item" href="/healthz">Health Probe</a>
							<a class="nav-dropdown-item" href="/readiness">Readiness Probe</a>
						</div>
					</div>
					<div class="nav-dropdown">
						<a class="nav-link px-2" href="#">Networking</a>
						<div class="nav-dropdown-menu">
							<a class="nav-dropdown-item" href="/downstream">Downstream Call</a>
							<a class="nav-dropdown-item" href="/ws">WebSocket</a>
						</div>
					</div>
					<div class="nav-dropdown">
						<a class="nav-link px-2" href="#">Stress Test</a>
						<div class="nav-dropdown-menu">
							<a class="nav-dropdown-item" href="/cpustress">CPU Stress</a>
							<a class="nav-dropdown-item" href="/memstress">Mem Stress</a>
						</div>
					</div>
					<div class="nav-dropdown">
						<a class="nav-link px-2" href="#">Characters</a>
						<div class="nav-dropdown-menu">
							<a class="nav-dropdown-item" href="/captainkube">Captain Kube</a>
							<a class="nav-dropdown-item" href="/goldie">Goldie</a>
							<a class="nav-dropdown-item" href="/phippy">Phippy</a>
							<a class="nav-dropdown-item" href="/zee">Zee</a>
						</div>
					</div>
					<a class="nav-link px-2" href="/docs">Docs</a>
				</div>
			</nav>
			<main class="container py-4 flex-fill">
				{{template "main" .}}
			</main>
			<footer class="footer bg-dark text-light py-3">
				<div class="container d-flex justify-content-center align-items-center">
					<img src="/static/images/desotech.png" id="desotech-logo" alt="Desotech">
					<p class="ml-3 mb-0 text-muted">&copy; 2020 Desotech</p>
				</div>
			</footer>
		</section>
	</body>
</html>
