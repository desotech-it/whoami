{{define "main"}}
<div class="mt-4">
	<div class="row">
		<div class="col-md-6 mb-3">
			<div class="card shadow-sm border-0 h-100">
				<div class="card-header bg-warning"><strong>DNS Summary</strong></div>
				<div class="table-responsive">
					<table class="table mb-0">
						<tbody>
							<tr><td class="font-weight-bold">Nameservers</td><td><code>{{range .DNS.Nameservers}}{{.}} {{end}}</code></td></tr>
							<tr><td class="font-weight-bold">Search Domains</td><td><code>{{range .DNS.SearchDomains}}{{.}} {{end}}</code></td></tr>
							<tr><td class="font-weight-bold">Options</td><td><code>{{.DNS.Options}}</code></td></tr>
						</tbody>
					</table>
				</div>
			</div>
		</div>
		<div class="col-md-6 mb-3">
			<div class="card shadow-sm border-0 h-100">
				<div class="card-header bg-secondary text-white"><strong>/etc/resolv.conf</strong></div>
				<div class="card-body p-0">
					<pre class="request-pre mb-0">{{.DNS.RawContent}}</pre>
				</div>
			</div>
		</div>
	</div>
	{{template "labinfo" .}}
</div>
{{end}}
