{{define "main"}}
<div class="mt-4">
	<div class="row">
		<div class="col-lg-5">
			<div class="card shadow-sm border-0 mb-3">
				<div class="card-header bg-primary text-white d-flex align-items-center">
					<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="mr-2" viewBox="0 0 16 16">
						<path d="M4 16s-1 0-1-1 1-4 5-4 5 3 5 4-1 1-1 1H4zm4-5.95a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z"/>
						<path d="M2 1a2 2 0 0 0-2 2v9.5A1.5 1.5 0 0 0 1.5 14h.653a5.373 5.373 0 0 1 1.066-2H1V3a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v3h-1V3H2z"/>
					</svg>
					<strong>Hostname</strong>
				</div>
				<div class="card-body">
					<code class="hostname-value">{{- .Info.Hostname -}}</code>
				</div>
			</div>
			{{template "request" .Request}}
			{{template "clientinfo" .ClientInfo}}
		</div>
		<div class="col-lg-7">
			<div class="card shadow-sm border-0 mb-3">
				<div class="card-header bg-success text-white d-flex align-items-center">
					<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="mr-2" viewBox="0 0 16 16">
						<path d="M6.5 1A1.5 1.5 0 0 0 5 2.5V3H1.5A1.5 1.5 0 0 0 0 4.5v8A1.5 1.5 0 0 0 1.5 14h13a1.5 1.5 0 0 0 1.5-1.5v-8A1.5 1.5 0 0 0 14.5 3H11v-.5A1.5 1.5 0 0 0 9.5 1h-3zm0 1h3a.5.5 0 0 1 .5.5V3H6v-.5a.5.5 0 0 1 .5-.5z"/>
						<path d="M8 8a1 1 0 1 0 0 2h.01a1 1 0 1 0 0-2H8z"/>
					</svg>
					<strong>Network Interfaces</strong>
				</div>
				<ul class="list-group list-group-flush">
				{{range $interface, $addresses := .Info.Addresses}}
					{{range $address := $addresses}}
					<li class="list-group-item d-flex justify-content-between align-items-center">
						<code>{{ $address }}</code>
						<span class="badge badge-success badge-pill">{{ $interface }}</span>
					</li>
					{{end}}
				{{end}}
				</ul>
			</div>
		</div>
	</div>
</div>
{{end}}
