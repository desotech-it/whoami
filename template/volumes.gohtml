{{define "main"}}
<div class="mt-4">
	<div class="row">
		<div class="col-12 mb-3">
			<div class="card shadow-sm border-0">
				<div class="card-header bg-success text-white"><strong>Mount Points</strong></div>
				{{if .Mounts}}
				<div class="table-responsive">
					<table class="table table-striped table-sm mb-0">
						<thead><tr><th>Path</th><th>Device</th><th>Filesystem</th><th>Options</th></tr></thead>
						<tbody>
						{{range .Mounts}}
							<tr>
								<td><code>{{.Path}}</code></td>
								<td><code>{{.Device}}</code></td>
								<td>{{.Filesystem}}</td>
								<td><small>{{.Options}}</small></td>
							</tr>
						{{end}}
						</tbody>
					</table>
				</div>
				{{else}}
				<div class="card-body text-muted">Not available (requires /proc/mounts)</div>
				{{end}}
			</div>
		</div>
	</div>
	{{template "labinfo" .}}
</div>
{{end}}
