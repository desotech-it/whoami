{{define "main"}}
<div class="mt-4">
	<div class="row">
		<div class="col-12 mb-3">
			<div class="card shadow-sm border-0 text-center py-5">
				<div class="card-body">
					<h1 class="display-1 font-weight-bold text-primary">{{.Count}}</h1>
					<p class="lead text-muted">Total requests served by this instance</p>
				</div>
			</div>
		</div>
	</div>
	{{template "labinfo" .}}
</div>
{{end}}
